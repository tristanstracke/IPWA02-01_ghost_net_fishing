<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.iu.ghostnet</groupId>
    <artifactId>ghost-net-fishing</artifactId>
    <version>1.0</version>
    <packaging>war</packaging>

    <name>Ghost Net Fishing</name>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Versionen zentral, damit man sie nicht überall im pom suchen muss -->
        <primefaces.version>8.0</primefaces.version>
        <hibernate.version>5.4.33.Final</hibernate.version>
        <derby.version>10.14.2.0</derby.version>
        <tomee.version>8.0.16</tomee.version>
    </properties>

    <dependencies>
        <!-- Java EE 8 Web Profile API. Steht auf dem Server bereit (JSF, CDI, JPA),
             deshalb provided und nicht ins WAR packen. -->
        <dependency>
            <groupId>javax</groupId>
            <artifactId>javaee-web-api</artifactId>
            <version>8.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Komponentenbibliothek für die Oberfläche -->
        <dependency>
            <groupId>org.primefaces</groupId>
            <artifactId>primefaces</artifactId>
            <version>${primefaces.version}</version>
        </dependency>

        <!-- JPA-Provider: Hibernate -->
        <dependency>
            <groupId>org.hibernate</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${hibernate.version}</version>
        </dependency>

        <!-- relationale DB: Apache Derby (eingebettet).
             Läuft direkt mit der Anwendung, kein separater Datenbankserver nötig. -->
        <dependency>
            <groupId>org.apache.derby</groupId>
            <artifactId>derby</artifactId>
            <version>${derby.version}</version>
        </dependency>
    </dependencies>

    <build>
        <!-- ohne diesen Namen hängt die Version am WAR und damit am Context-Path -->
        <finalName>ghost-net-fishing</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.3.2</version>
            </plugin>

            <!-- Startet die App mit einem eingebetteten Apache-TomEE-Server
                 per "mvn tomee:run". So muss kein Server separat installiert werden. -->
            <plugin>
                <groupId>org.apache.tomee.maven</groupId>
                <artifactId>tomee-maven-plugin</artifactId>
                <version>${tomee.version}</version>
                <configuration>
                    <tomeeClassifier>webprofile</tomeeClassifier>
                    <context>ghost-net-fishing</context>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
